          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Copy All": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar todo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部复制"
          }
        }
      }
    },
    "Couldn’t connect over Bluetooth. Is the camera on and nearby?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar por Bluetooth. ¿La cámara está encendida y cerca?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙连接失败。请确认相机已开机并在附近。"
          }
        }
      }
    },
    "Couldn’t eject the card. Close anything still reading it and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo expulsar la tarjeta. Cerrá lo que la esté leyendo y probá de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法推出存储卡。关闭正在读取它的程序后重试。"
          }
        }
      }
    },
    "Couldn’t get back to your Wi-Fi on its own. Pick your network in the menu bar.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo volver solo a tu Wi-Fi. Elegí tu red en la barra de menús."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法自动恢复原来的 Wi-Fi。请在菜单栏选择你的网络。"
          }
        }
      }
    },
    "Couldn’t join the camera’s Wi-Fi network (%@). Bring the Mac closer to the camera and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo entrar a la red Wi-Fi de la cámara (%@). Acercá la Mac a la cámara y probá de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加入相机的 Wi-Fi（%@）。将 Mac 靠近相机后重试。"
          }
        }
      }
    },
    "Couldn’t open the preview": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la vista previa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开预览"
          }
        }
      }
    },
    "Couldn’t reach GitHub. Check your Internet connection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo llegar a GitHub. Revisá tu conexión a Internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 GitHub。请检查互联网连接。"
          }
        }
      }
    },
    "Credits": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Créditos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "致谢"
          }
        }
      }
    },
