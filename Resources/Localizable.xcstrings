    "Restart to apply the language to all windows and menus. Your camera will disconnect first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启后所有窗口和菜单都会使用新语言。重启前会先断开相机连接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciá para aplicar el idioma a todas las ventanas y menús. Primero se desconectará la cámara."
          }
        }
      }
    },
