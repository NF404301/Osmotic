    "What already arrived stays saved; the rest resumes next time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo ya descargado queda guardado; lo demás se reanuda la próxima vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已传输的内容会保留，其余内容可下次继续。"
          }
        }
      }
    },
    "What’s new in %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades de %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 更新内容"
          }
        }
      }
    },
    "While connected, your Mac uses the camera’s Wi-Fi and has no Internet over Wi-Fi; it goes back to your network when you disconnect. To stay online, plug the Mac into Ethernet or share an iPhone’s connection over USB.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras dure la conexión, tu Mac usa el Wi-Fi de la cámara y queda sin Internet por Wi-Fi; al desconectar vuelve a tu red. Para seguir con Internet, conectá la Mac por Ethernet o el iPhone por cable con Compartir Internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接期间，Mac 使用相机的 Wi-Fi，无法通过 Wi-Fi 上网；断开后会恢复原来的网络。如需保持上网，可使用以太网或通过 USB 共享 iPhone 网络。"
          }
        }
      }
    },
    "Wi-Fi": {
      "shouldTranslate": false,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi"
          }
        }
      }
    },
