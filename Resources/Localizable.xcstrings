          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osmotic 没有蓝牙权限。请在“系统设置 › 隐私与安全性 › 蓝牙”中开启。"
          }
        }
      }
    },
