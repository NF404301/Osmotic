            "state": "translated",
            "value": "desde la cámara"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自相机"
          }
        }
      }
    },
    "lightweight preview": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "vista previa liviana"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻量预览"
          }
        }
      }
    },
    "macOS won’t let Osmotic read the card yet. Allow it in System Settings › Privacy & Security › Files and Folders, or pick the card yourself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS todavía no deja que Osmotic lea la tarjeta. Permitilo en Configuración del Sistema › Privacidad y seguridad › Archivos y carpetas, o elegí la tarjeta vos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 尚未允许 Osmotic 读取存储卡。请在“系统设置 › 隐私与安全性 › 文件与文件夹”中允许，或手动选择存储卡。"
          }
        }
      }
    },
