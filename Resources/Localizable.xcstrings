    "Can’t find the camera. Turn it on and bring it close to the Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra la cámara. Encendela y acercala a la Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到相机。请开机并将其靠近 Mac。"
          }
        }
      }
    },
    "Card": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjeta"
