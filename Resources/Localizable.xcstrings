{
  "sourceLanguage": "en",
  "strings": {
    "%@ free of %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libres de %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@，共 %@"
          }
        }
      }
    },
    "%@ in %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，用时 %@"
          }
        }
      }
    },
    "%@/s": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/s"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/秒"
          }
        }
      }
    },
    "%lld arrived, %lld didn’t. Open Osmotic to try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld descargados, %lld no. Abrí Osmotic para reintentar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载 %lld 个，%lld 个未完成。打开 Osmotic 重试。"
          }
        }
      }
    },
    "%lld cameras found": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld camera found"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cameras found"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cámara encontrada"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cámaras encontradas"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现 %lld 台相机"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld archivo"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld archivos"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件"
          }
        }
      }
    },
    "%lld files couldn’t be downloaded. Try again to resume.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file couldn’t be downloaded. Try again to resume."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files couldn’t be downloaded. Try again to resume."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld archivo no se pudo descargar. Reintentá para reanudar."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld archivos no se pudieron descargar. Reintentá para reanudar."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件下载失败。重试可继续下载。"
          }
        }
      }
    },
    "%lld of 4": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de 4"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4 格中的 %lld 格"
          }
        }
      }
    },
    "A pairing request shows up on its screen: tap the check mark. Only needed the first time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En su pantalla aparece un pedido de emparejamiento: tocá la tilde. Solo la primera vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机屏幕会显示配对请求，点勾确认。仅首次连接需要。"
          }
        }
      }
    },
    "Add to selection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar a la selección"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入选择"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All downloaded": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo descargado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部已下载"
          }
        }
      }
    },
    "All queued": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en cola"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部已加入队列"
          }
        }
      }
    },
    "Already in your downloads folder": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está en tu carpeta de descargas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在下载文件夹中"
          }
        }
      }
    },
    "Approve on the camera": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobá en la cámara"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相机上确认"
          }
        }
      }
    },
    "Approve the connection on the camera": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobá la conexión en la cámara"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相机上允许连接"
          }
        }
      }
    },
    "Approve the connection on the camera’s screen": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobá la conexión en la pantalla de la cámara"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相机屏幕上允许连接"
          }
        }
      }
    },
    "As a webcam, the picture goes over the cable in full quality and the camera charges. The Live tab works without the cable, over Wi-Fi, at preview quality.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como webcam, la imagen va por el cable en calidad completa y la cámara se carga. La pestaña En vivo funciona sin cable, por Wi-Fi, en calidad de vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为网络摄像头时，通过数据线传输原画质画面并给相机充电。实时画面通过 Wi-Fi 传输预览画质，无需数据线。"
          }
        }
      }
    },
    "Asking the camera for its Wi-Fi network…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidiendo la red Wi-Fi a la cámara…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取相机的 Wi-Fi 信息…"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "Batt": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量"
          }
        }
      }
    },
    "Blinking": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parpadeando"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闪烁"
          }
        }
      }
    },
    "Bluetooth": {
      "shouldTranslate": false,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙"
          }
        }
      }
    },
    "Bluetooth is off. Turn it on to find your camera.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth está apagado. Encendelo para encontrar tu cámara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已关闭。打开蓝牙以查找相机。"
          }
        }
      }
    },
    "Bluetooth off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth apagado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已关闭"
