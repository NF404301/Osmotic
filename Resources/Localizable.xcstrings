    "%@ is plugged in, but its card isn’t showing up. Unplug the cable and plug it back in, or pick USB storage on the camera.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está enchufada, pero su tarjeta no aparece. Desenchufá el cable y volvé a enchufarlo, o elegí almacenamiento USB en la cámara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接，但未显示存储卡。请重新插拔数据线，或在相机上选择 USB 存储模式。"
          }
        }
      }
    },
